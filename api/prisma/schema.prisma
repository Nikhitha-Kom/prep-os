generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Application {
  id        String   @id @default(uuid())
  company   String
  role      String
  status    String   @default("applied")
  source    String?
  jdUrl     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
